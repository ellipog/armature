{
    "schemaVersion": 1,
    "id": "${mod_id}",
    "version": "${version}",
    "name": "${mod_name}",
    "description": "${description}",
    "authors": [
        "${mod_author}"
    ],
    "contact": {},
    "license": "${license}",
    "icon": "assets/armature/icon.png",
    "environment": "*",
    "entrypoints": {
        "main": [
            "dev.ellipog.armature.fabric.ArmatureFabric"
        ],
        "client": [
            "dev.ellipog.armature.fabric.FabricClient"
        ]
    },
    "depends": {
        "fabricloader": ">=${fabric_loader_version}",
        "fabric-api": "*",
        "minecraft": "${minecraft_version}",
        "java": ">=${java_version}"
    }
}
