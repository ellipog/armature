{
    "schemaVersion": 1,
    "id": "${mod_id}",
    "version": "${version}",
    "name": "${mod_name}",
    "description": "${description}",
    "icon": "assets/armature/icon.png",
    "authors": [
        "${mod_author}"
    ],
    "contact": {
        "homepage": "https://ellipog.dev",
        "sources": "https://github.com/ellipog/armature",
        "issues": "https://github.com/ellipog/armature/issues"
    },
    "license": "${license}",
    "environment": "*",
    "accessWidener": "armature.accesswidener",
    "entrypoints": {
        "main": [
            "dev.ellipog.armature.fabric.ArmatureFabric"
        ],
        "client": [
            "dev.ellipog.armature.fabric.FabricClient"
        ]
    },
    "depends": {
        "fabricloader": ">=${fabric_loader_version}",
        "fabric-api": ">=${fabric_version}",
        "minecraft": "${minecraft_version}",
        "java": ">=${java_version}"
    }
}
